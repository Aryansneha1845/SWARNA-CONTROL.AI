# All free, no credit card. NEVER commit real values — this file is an example only.
# Copy to .env and fill in. .env is gitignored.
# Server-side secrets (never exposed to browsers):
ETHERSCAN_API_KEY=your_etherscan_free_key
GEMINI_API_KEY=your_aistudio_key
GROQ_API_KEY=your_groq_key
ETH_RPC_URL=https://rpc.ankr.com/eth
# Backend access gate. When set (non-empty), every POST /investigate etc.
# requires header X-API-Key. The browser never sees this key: Next.js
# API routes (/app/api/*) attach it server-side. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SWARN_API_KEY=change-me-generate-a-random-value
# Comma-separated allowed browser origins. No wildcard allowed.
FRONTEND_ORIGIN=http://localhost:3000
# dev | prod. prod disables /docs, /redoc, /openapi.json and enables HSTS.
ENV=dev
